{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmitOnError": true,
		"outDir": "static",
		"rootDir": "src",
		"removeComments": false,
		"sourceMap": false
	},
	"include": ["src/**/*.ts"]
}
